import AxeBuilder from '@axe-core/playwright';
import { expect, test } from '@playwright/test';

import { harnessRoutes } from './routes';

// Mark an element with data-a11y-ignore only when WCAG exempts it, such as a logo wordmark
// (WCAG 1.4.3). Say why in a comment next to the attribute.

for (const route of harnessRoutes()) {
  test(`${route} has no serious accessibility violations`, async ({ page }) => {
    await page.goto(route, { waitUntil: 'networkidle' });
    const results = await new AxeBuilder({ page })
      .withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa'])
      .exclude('[data-a11y-ignore]')
      .analyze();
    const serious = results.violations
      .filter((violation) => violation.impact === 'serious' || violation.impact === 'critical')
      .map((violation) => `${violation.id} (${violation.nodes.length}): ${violation.help}`);

    expect(serious, `axe violations on ${route}`).toEqual([]);
  });
}
