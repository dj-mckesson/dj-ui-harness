import { defineConfig, devices } from '@playwright/test';

// The harness runs the `smoke` and `a11y` projects as the `browser` and `a11y` checks.
// `harness.toml` sets how to start the app through these variables:
// - E2E_WEB_SERVER: shell command that serves the built app. `{port}` becomes the port.
// - E2E_BASE_URL: use an app that is already running instead of starting one.
// - E2E_API_SERVER and E2E_API_URL: also start a backend and wait for this URL.
const port = Number(process.env.E2E_PORT ?? 3100);
const baseURL = process.env.E2E_BASE_URL ?? `http://localhost:${port}`;
const webCommand = (process.env.E2E_WEB_SERVER ?? 'npm run build && npm start -- --port {port}')
  .replaceAll('{port}', String(port));

const servers = [];
if (process.env.E2E_API_SERVER) {
  servers.push({
    command: process.env.E2E_API_SERVER,
    url: process.env.E2E_API_URL ?? 'http://localhost:8000',
    reuseExistingServer: false,
    timeout: 300_000,
  });
}
if (!process.env.E2E_BASE_URL) {
  servers.push({ command: webCommand, url: baseURL, reuseExistingServer: false, timeout: 300_000 });
}

export default defineConfig({
  testDir: 'e2e',
  fullyParallel: true,
  forbidOnly: true,
  retries: 0,
  reporter: [['list']],
  use: {
    baseURL,
    trace: 'retain-on-failure',
    screenshot: 'only-on-failure',
  },
  projects: [
    { name: 'smoke', testMatch: 'harness/smoke.spec.ts', use: { ...devices['Desktop Chrome'] } },
    { name: 'a11y', testMatch: 'harness/a11y.spec.ts', use: { ...devices['Desktop Chrome'] } },
  ],
  webServer: servers,
});
